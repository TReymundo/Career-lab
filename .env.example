# Recruiter-email scanning. Copy this file to .env and fill it in; .env is gitignored.
# Gmail: create an app password at Google Account → Security → 2-Step Verification → App passwords.
# Your password is read from here by the API process only — it is never stored in the database
# and never entered through the app's interface.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@gmail.com
IMAP_PASSWORD=
